<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlashDraft.App.App">
    <!-- FlashDraft design language. Authored from scratch; no PCL assets,
         XAML, images, fonts or logo files are used. -->
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="#F2F5FB" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,12" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#1B2430" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Application.Styles>
</Application>
