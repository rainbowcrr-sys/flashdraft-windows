<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlashDraft.App.MainView">
    <!-- Three real pages: Transfer, About (a tab in the main shell) and the
         first-run License page. The license page is a sibling of the shell,
         so nothing is ever stacked on top of the main interface. -->
    <Grid Background="#F2F5FB">

        <!-- Main shell: brand bar + side navigation + cards. -->
        <Grid IsVisible="{Binding MainVisible}" RowDefinitions="Auto,*">
        <!-- Brand bar, shared by every standalone page. -->
        <Border Grid.Row="0" Height="72">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B47C9" Offset="0" />
                    <GradientStop Color="#3A82F0" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto" Margin="24,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="White" VerticalAlignment="Center">
                        <Viewbox Margin="2">
                            <Canvas Width="108" Height="108">
                                <Rectangle Width="108" Height="108" RadiusX="24" RadiusY="24">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0B47C9" Offset="0" />
                                            <GradientStop Color="#3A82F0" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Path Data="M33 42 H75" Stroke="White" StrokeThickness="7"
                                      StrokeLineCap="Round" />
                                <Path Data="M68 35 L77 42 L68 49" Stroke="White"
                                      StrokeThickness="7" StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <Path Data="M75 66 H33" Stroke="White" StrokeThickness="7"
                                      StrokeLineCap="Round" />
                                <Path Data="M40 59 L31 66 L40 73" Stroke="White"
                                      StrokeThickness="7" StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <Path Data="M57 47 L47 59 H54 L50 70 L64 55 H56 Z"
                                      Fill="#FFD84D" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.AppTitle}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{DynamicResource Str.Subtitle}" FontSize="11"
                                   Foreground="#D6E6FF" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="14"
                        Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#6EE7A8"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str.Ready}" FontSize="12" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

            <TabControl Grid.Row="1" TabStripPlacement="Left"
                        Background="Transparent" Padding="0">
                <TabItem Header="{DynamicResource Str.TabTransfer}">
                    <Border Margin="20" Padding="26" Background="White"
                            CornerRadius="14" BoxShadow="0 6 22 0 #1E1B2430">
                        <ScrollViewer>
                            <StackPanel Spacing="11">

                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,4,0,2">
                                <Border Width="3" Height="15" CornerRadius="2"
                                        Background="#0B47C9" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str.Pairing}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#0B47C9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Height="1" Background="#E6EBF4" Margin="0,0,0,6" />
                                <TextBlock Text="{DynamicResource Str.MyOfferCode}" FontSize="12" Foreground="#667085" />
                                <TextBox Text="{Binding LocalCode}" IsReadOnly="True"
                                         Watermark="{DynamicResource Str.WatermarkGenerate}" />

                                <TextBlock Text="{DynamicResource Str.PeerOfferCode}" FontSize="12" Foreground="#667085" />
                                <TextBox Text="{Binding RemoteCode}"
                                         Watermark="flashdraft://..." />

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3,0,0">
                                    <Button Content="{DynamicResource Str.GenerateCode}" Background="#0B47C9"
                                            Foreground="White"
                                            Command="{Binding GenerateCodeCommand}" />
                                    <Button Content="{DynamicResource Str.BindPeer}"
                                            Command="{Binding BindPeerCommand}" />
                                    <CheckBox Content="{DynamicResource Str.WanMode}"
                                              IsChecked="{Binding IsWanMode}"
                                              VerticalAlignment="Center" />
                                </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,4,0,2">
                                <Border Width="3" Height="15" CornerRadius="2"
                                        Background="#0B47C9" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str.TabTransfer}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#0B47C9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Height="1" Background="#E6EBF4" Margin="0,0,0,6" />
                                <TextBlock Text="{DynamicResource Str.SourceFile}" FontSize="12" Foreground="#667085" />
                                <TextBox Text="{Binding SourcePath}"
                                         Watermark="{DynamicResource Str.WatermarkSource}" />

                                <TextBlock Text="{DynamicResource Str.DestDir}" FontSize="12"
                                           Foreground="#667085" />
                                <TextBox Text="{Binding DestinationPath}"
                                         Watermark="{DynamicResource Str.WatermarkDest}" />

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3,0,0">
                                    <Button Content="{DynamicResource Str.WaitTransfer}"
                                            Command="{Binding WaitForTransferCommand}" />
                                    <Button Content="{DynamicResource Str.SendFile}" Background="#0B47C9"
                                            Foreground="White"
                                            Command="{Binding SendFileCommand}" />
                                    <Button Content="{DynamicResource Str.Loopback}"
                                            Command="{Binding RunLoopbackTestCommand}" />
                                    <Button Content="{DynamicResource Str.Cancel}" Foreground="#B42318"
                                            Command="{Binding CancelCommand}" />
                                </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,4,0,2">
                                <Border Width="3" Height="15" CornerRadius="2"
                                        Background="#0B47C9" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str.Progress}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#0B47C9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Height="1" Background="#E6EBF4" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <TextBlock Text="{Binding StatusText}" Foreground="#667085" />
                                    <TextBlock Text="{Binding SpeedText}" Foreground="#667085" />
                                </StackPanel>

                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent}"
                                             Height="10" Foreground="#0B47C9" />
                                <ListBox Height="86" ItemsSource="{Binding Devices}" />

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <TabItem Header="{DynamicResource Str.TabAbout}">
                    <Border Margin="20" Padding="26" Background="White"
                            CornerRadius="14" BoxShadow="0 6 22 0 #1E1B2430">
                        <ScrollViewer>
                            <StackPanel Spacing="11">

                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,4,0,2">
                                <Border Width="3" Height="15" CornerRadius="2"
                                        Background="#0B47C9" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str.AboutTitle}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#0B47C9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Height="1" Background="#E6EBF4" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding AboutText}" TextWrapping="Wrap"
                                           FontSize="13" Foreground="#1B2430" />

                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,4,0,2">
                                <Border Width="3" Height="15" CornerRadius="2"
                                        Background="#0B47C9" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str.LicenseTitle}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#0B47C9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Height="1" Background="#E6EBF4" Margin="0,0,0,6" />
                                <Border Background="#F7F9FD" CornerRadius="8"
                                        BorderBrush="#E6EBF4" BorderThickness="1" Padding="12">
                                    <ScrollViewer Height="300">
                                        <TextBlock Text="{Binding LicenseText}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="#1B2430" />
                                    </ScrollViewer>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <TabItem Header="{DynamicResource Str.TabSettings}">
                    <Border Margin="20" Padding="26" Background="White"
                            CornerRadius="14" BoxShadow="0 6 22 0 #1E1B2430">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{DynamicResource Str.SettingsTitle}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="#0B47C9" />
                            <Border Height="1" Background="#E6EBF4" />
                            <TextBlock Text="{DynamicResource Str.LanguageLabel}" FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Str.LanguageHint}" FontSize="12"
                                       Foreground="#667085" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Str.DefaultFromInstall}" FontSize="12"
                                       Foreground="#667085" TextWrapping="Wrap" />
                            <StackPanel Spacing="10" Margin="0,6,0,0">
                                <RadioButton Content="{DynamicResource Str.LangChinese}"
                                             GroupName="Language" FontSize="14"
                                             IsChecked="{Binding IsChinese}"
                                             Command="{Binding SetLanguageCommand}"
                                             CommandParameter="zh-CN" />
                                <RadioButton Content="{DynamicResource Str.LangEnglish}"
                                             GroupName="Language" FontSize="14"
                                             IsChecked="{Binding IsEnglish}"
                                             Command="{Binding SetLanguageCommand}"
                                             CommandParameter="en-US" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Str.Saved}" FontSize="12"
                                       Foreground="#2FBF71" />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Standalone first-run license page. It is a sibling of the main
             shell, not an overlay: exactly one of the two pages is visible. -->
        <Grid IsVisible="{Binding LicensePending}" RowDefinitions="Auto,*"
              Background="#F2F5FB">
        <!-- Brand bar, shared by every standalone page. -->
        <Border Grid.Row="0" Height="72">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B47C9" Offset="0" />
                    <GradientStop Color="#3A82F0" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto" Margin="24,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="White" VerticalAlignment="Center">
                        <Viewbox Margin="2">
                            <Canvas Width="108" Height="108">
                                <Rectangle Width="108" Height="108" RadiusX="24" RadiusY="24">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0B47C9" Offset="0" />
                                            <GradientStop Color="#3A82F0" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Path Data="M33 42 H75" Stroke="White" StrokeThickness="7"
                                      StrokeLineCap="Round" />
                                <Path Data="M68 35 L77 42 L68 49" Stroke="White"
                                      StrokeThickness="7" StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <Path Data="M75 66 H33" Stroke="White" StrokeThickness="7"
                                      StrokeLineCap="Round" />
                                <Path Data="M40 59 L31 66 L40 73" Stroke="White"
                                      StrokeThickness="7" StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <Path Data="M57 47 L47 59 H54 L50 70 L64 55 H56 Z"
                                      Fill="#FFD84D" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.AppTitle}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{DynamicResource Str.Subtitle}" FontSize="11"
                                   Foreground="#D6E6FF" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="14"
                        Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#6EE7A8"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str.Ready}" FontSize="12" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

            <Border Grid.Row="1" Margin="36" Padding="26" Background="White"
                    CornerRadius="14" BoxShadow="0 10 40 0 #33000000"
                    MaxWidth="860" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto,Auto" MinHeight="420">
                    <TextBlock Grid.Row="0" Text="{DynamicResource Str.LicenseAgreement}"
                               FontSize="18" FontWeight="SemiBold" Foreground="#0B47C9"
                               Margin="0,0,0,12" />
                    <Border Grid.Row="1" Background="#F7F9FD" CornerRadius="8"
                            BorderBrush="#E6EBF4" BorderThickness="1" Padding="12">
                        <ScrollViewer>
                            <TextBlock Text="{Binding LicenseText}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="#1B2430" />
                        </ScrollViewer>
                    </Border>
                    <CheckBox Grid.Row="2"
                              Content="{DynamicResource Str.AcceptLicense}"
                              IsChecked="{Binding LicenseAccepted}" Margin="0,14,0,0" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="14"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Str.DeclineHint}"
                                   FontSize="11" Foreground="#667085"
                                   VerticalAlignment="Center" />
                        <Button Content="{DynamicResource Str.Continue}" Background="#0B47C9"
                                Foreground="White" IsEnabled="{Binding LicenseAccepted}"
                                Command="{Binding AcceptLicenseCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
